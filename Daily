def get_linac_stats(linac_data):
    # Get the current date in 'YYYY-mm-dd' format
    current_date = datetime.today().strftime('%Y-%m-%d')

    # Initialize dictionaries to store the number of patients and VMATs
    patients_per_linac = {}
    vmat_per_linac = {}

    # Loop through the linac_data and assign values
    for linac, data in linac_data.items():
        patients_per_linac[linac] = len(data['patients'])  # Number of patients
        vmat_per_linac[linac] = data['VMAT_counter']      # Number of VMATs

    # Extract the values into individual variables
    rtd3_pats = patients_per_linac['rtd3']
    rtd4_pats = patients_per_linac['rtd4']
    hdrs1_pats = patients_per_linac['hdrs1']
    hdrs2_pats = patients_per_linac['hdrs2']

    rtd3_VMAT = vmat_per_linac['rtd3']
    rtd4_VMAT = vmat_per_linac['rtd4']
    hdrs1_VMAT = vmat_per_linac['hdrs1']
    hdrs2_VMAT = vmat_per_linac['hdrs2']

    # Return the current date, number of patients, and VMATs per LINAC
    return current_date, rtd3_pats, rtd4_pats, hdrs1_pats, hdrs2_pats, rtd3_VMAT, rtd4_VMAT, hdrs1_VMAT, hdrs2_VMAT

def upload_patient_counts(date, rtd3_pats, rtd4_pats, hdrs1_pats, hdrs2_pats, rtd3_VMAT, rtd4_VMAT, hdrs1_VMAT, hdrs2_VMAT):
    try:
        conn = connect_to_database()
        if conn is None:
            return

        cursor = conn.cursor()

        # SQL query to insert the values into the table
        sql_query = """
        INSERT INTO patient_counts (date, rtd3_pats, rtd4_pats, hdrs1_pats, hdrs2_pats, rtd3_VMAT, rtd4_VMAT, hdrs1_VMAT, hdrs2_VMAT)
        VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)
        """
        print(sql_query)
        # Execute the query with the patient counts as values
        cursor.execute(sql_query, (date, rtd3_pats, rtd4_pats, hdrs1_pats, hdrs2_pats, rtd3_VMAT, rtd4_VMAT, hdrs1_VMAT, hdrs2_VMAT))

        # Commit the transaction
        conn.commit()

        print("Data uploaded successfully.")
    except mysql.connector.Error as err:
        print(f"Error: {err}")
    finally:
        if conn is not None:
            cursor.close()
            conn.close()

