# Function to process LINAC data
def process_linac(dirpath, linac, today, regex, TimeStamps, IDS, linac_data, ph_energies, rtg_fields, electron_fields, ph_fields):
    VMAT, CONF, PAT_NUM = 0, 0, 0
    linac_dict = linac_data[linac]

    try:
        input_file = Path(dirpath, linac, f"ILR_{today.strftime('%Y%m%d')}.txt")
        with open(input_file, 'rb') as file:
            fread = file.read()
        mytext = fread.decode('utf-16')
        matches = re.finditer(regex, mytext, re.IGNORECASE | re.UNICODE)
    except FileNotFoundError:
        print(f"There is no such file as {input_file}")
        return ""
    except UnicodeDecodeError:
        print(f"Error decoding file {input_file}")
        return ""

    # Process each match found by the regex
    for match in matches:
        time_value = match.groupdict().get('Time')
        if time_value and time_value not in TimeStamps:
            TimeStamps.append(time_value)

        patient_id = match.groupdict().get('Id')
        if patient_id:
            PAT_NUM += 1
            if patient_id not in IDS:
                IDS.append(patient_id)
            if patient_id not in linac_dict['patients']:
                linac_dict['patients'].append(patient_id)
                if match.group('SETGantDir') != 'NONE':
                    linac_dict['VMAT_counter'] += 1

        set_energy = match.groupdict().get('SETEnergy')
        if set_energy and set_energy not in ph_energies:
            if set_energy == 'Check RG  ':
                rtg_fields.append(set_energy)
            else:
                electron_fields.append(set_energy)
        else:
            ph_fields.append(set_energy)

        term_code = match.groupdict().get('TermCode')
        set_gant_dir = match.groupdict().get('SETGantDir')
        if term_code == '501' and set_gant_dir != 'NONE':
            VMAT += 1
        if term_code == '501' and set_gant_dir == 'NONE':
            CONF += 1
        else:
            pass
    if TimeStamps:
        start_time = datetime.strptime(min(TimeStamps), '%H:%M:%S')
        end_time = datetime.strptime(max(TimeStamps), '%H:%M:%S')
        WorkingHours = end_time - start_time
        report = (f"Az {linac} {start_time.strftime('%H:%M:%S')}-től {end_time.strftime('%H:%M:%S')}-ig kezelt.\n"
                  f"Összesen: {WorkingHours} órát\n"
                  f"VMAT mezők száma: {VMAT}\n"
                  f"Statikus mezők száma: {CONF}\n\n")
    else:
        report = f"A {linac} nem kezelt ma.\n\n"

    return report

# Generate report summary
def generate_report(linac_data, electron_fields):
    report = ""
    for linac in linac_data.keys():
        linac_report = process_linac(dirpath, linac, today, regex, TimeStamps, IDS, linac_data, ph_energies, rtg_fields,
                                     electron_fields, ph_fields)
        if linac_report:
            report +=linac_report
    for linac, data in linac_data.items():
        num_patients = len(data['patients'])
        if num_patients > 0 and data['VMAT_counter'] > 0:
            vmat_ratio = (data['VMAT_counter'] / num_patients) * 100
            report += f"\n\n{linac.upper()} \nBeteg száma: {num_patients}  VMAT arány: {round(vmat_ratio)}%"
        else:
            report += f"\n\n{linac.upper()} nem kezelt ma."

    total_patients = sum(len(data['patients']) for data in linac_data.values())
    total_vmat = sum(data['VMAT_counter'] for data in linac_data.values())

    if total_patients > 0:
        overall_vmat_ratio = (total_vmat / total_patients) * 100
        report += (f"\n\nÖsszesen\nBetegek száma: {total_patients}  "
                   f"VMAT arány: {round(overall_vmat_ratio)}%")
    report += f"\n\nElektron mezők száma: {len(electron_fields)}"
    return report


